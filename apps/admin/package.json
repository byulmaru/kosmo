{
  "name": "@kosmo/admin",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "build": "svelte-kit sync && vite build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "dev": "vite dev --host 0.0.0.0 --port 8080",
    "start": "node build",
    "test": "pnpm check && pnpm test:unit",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@sveltejs/kit": "^2.70.3",
    "svelte": "^5.56.4"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "svelte-check": "^4.7.6",
    "vite": "^8.0.16",
    "vitest": "^4.1.10"
  }
}
