{
  "name": "@kosmo/monorepo",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621",
  "scripts": {
    "audit:local-profile-handles": "pnpm --filter @kosmo/core exec node --import tsx ../../scripts/audit-local-profile-handles.mjs",
    "build:sentry-artifacts": "node scripts/build-sentry-artifacts.mjs",
    "db:test:down": "node scripts/test-db.mjs down",
    "db:test:drop": "node scripts/test-db.mjs drop",
    "db:test:push": "env DATABASE_URL=\"${DATABASE_URL:-postgres://kosmo:kosmo@localhost:54329/kosmo_test}\" pnpm --filter @kosmo/core db:migrate && env DATABASE_URL=\"${DATABASE_URL:-postgres://kosmo:kosmo@localhost:54329/kosmo_test}\" NODE_OPTIONS='--preserve-symlinks --preserve-symlinks-main' ./packages/core/node_modules/.bin/drizzle-kit push --config packages/core/drizzle.config.ts",
    "db:test:reset": "node scripts/test-db.mjs reset",
    "db:test:up": "node scripts/test-db.mjs up",
    "db:bootstrap-local-instance": "pnpm --filter @kosmo/api db:bootstrap-local-instance",
    "dev": "node scripts/vault-run.mjs -- pnpm --recursive --parallel --if-present dev",
    "dev:worker": "node scripts/vault-run.mjs -- pnpm --filter @kosmo/worker start",
    "lint:eslint": "eslint --max-warnings 0 .",
    "lint:prettier": "prettier --check --ignore-unknown '**/*'",
    "lint:syncpack": "syncpack lint --dependency-types prod,dev,peer",
    "prepare": "husky || true",
    "test": "pnpm test:eslint && pnpm test:audit:local-profile-handles && pnpm --recursive --workspace-concurrency=1 --if-present test",
    "test:audit:local-profile-handles": "pnpm --filter @kosmo/core exec node --import tsx --test ../../scripts/audit-local-profile-handles.test.mjs",
    "test:eslint": "node --test scripts/eslint-no-class-component.test.mjs",
    "test:e2e": "node scripts/test-db.mjs run -- pnpm test:e2e:database",
    "test:e2e:database": "pnpm db:test:push && pnpm --filter @kosmo/web test:e2e",
    "test:fedify": "node scripts/test-db.mjs run -- pnpm test:fedify:database",
    "test:fedify:database": "pnpm db:test:push && pnpm --filter @kosmo/fedify test:unit && pnpm --filter @kosmo/fedify-consumer test:unit"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "5.11.3",
    "@eslint/js": "^9.39.4",
    "@fission-ai/openspec": "^1.3.1",
    "@optique/core": "^1.1.1",
    "@optique/run": "^1.1.1",
    "@sentry/cli": "^3.6.0",
    "@types/node": "^25.6.2",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "ms": "^2.1.3",
    "prettier": "^3.8.3",
    "prettier-plugin-brace-style": "^0.10.1",
    "prettier-plugin-svelte": "^3.5.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "syncpack": "^14.3.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2"
  },
  "type": "module"
}
